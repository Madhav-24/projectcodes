# PPE Detection WebSocket backend URL
# Override in production to point to your deployed FastAPI server
VITE_PPE_WS_URL=ws://localhost:8000/ws/camera

# ─── Backend (Express + PostgreSQL) ─────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ppe_safety

# JWT secret — use a long random string in production (32+ chars)
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Argon2 password hashing options
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Seed admin credentials (used on first start if admin user does not exist)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@1234
ADMIN_SYNC_ON_STARTUP=true

# PPE engine -> backend ingest endpoint protection
PPE_INGEST_KEY=replace_with_long_random_machine_key
PPE_ALERT_API_URL=http://localhost:4000/api/alerts/ppe
PPE_ALERT_SITE=All Sites

# Express server port
PORT=4000

# Allowed frontend origin for CORS (set specific URL in production)
CLIENT_ORIGIN=http://localhost:5173

# ─── Frontend (Vite — must be prefixed VITE_) ────────────────────────────────
VITE_API_URL=http://localhost:4000

